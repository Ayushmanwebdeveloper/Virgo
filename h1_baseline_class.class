! ============================================================================
! H1 21cm Polynomial Baseline Subtraction - GILDAS/CLASS Script
! ============================================================================
!
! Professional implementation based on:
! - IRAM/GILDAS CLASS standard procedures
! - European observatory practices (Effelsberg EBHIS, etc.)
! - Standard methods from Barnes et al. (2001) HIPASS
!
! Author: Radio Astronomy Standard Pipeline
! Date: 2025
! Version: 1.0
!
! Compatible with: GILDAS nov25a and later
! ============================================================================

! ============================================================================
! CONFIGURATION PARAMETERS
! ============================================================================

! Input/Output files
define character input_file "your_spectrum.30m"
define character output_file "corrected_spectrum.30m"
define character output_ascii "corrected_spectrum.dat"

! Baseline parameters
define integer poly_order 2              ! Polynomial order (0-9)
                                         ! 1 = linear (20% of cases)
                                         ! 2 = quadratic (60% STANDARD)
                                         ! 3 = cubic (10% of cases)

! Line-free window definition (velocity in km/s)
define real exclude_velocity 300.0      ! Standard: ±300 km/s
define real vmin_left -1000.0           ! Left window start
define real vmax_left  0.0 - exclude_velocity  ! Left window end (auto-calculated)
define real vmin_right 0.0 + exclude_velocity  ! Right window start (auto-calculated)
define real vmax_right 1000.0           ! Right window end

! Iterative sigma clipping
define integer max_iterations 5         ! Max iterations (CLASS supports iterate)
define real sigma_clip 3.0             ! Sigma clipping threshold

! Smoothing parameters
define logical do_smoothing .true.     ! Apply smoothing after baseline removal
define character smooth_method "HANNING"  ! HANNING, BOX, GAUSS
define integer smooth_width 11         ! Smoothing width in channels

! RFI spike removal
define logical remove_spikes .false.   ! Enable RFI spike removal
define real spike_threshold 5.0        ! Spike detection threshold (sigma)

! Display and output options
define logical show_plots .true.       ! Show plots during processing
define logical save_plots .true.       ! Save plots to files
define logical verbose .true.          ! Print diagnostic information

! H1 rest frequency (MHz)
define real h1_rest_freq 1420.405751   ! Precise CODATA value

! ============================================================================
! MAIN PROCESSING PIPELINE
! ============================================================================

say "============================================================================"
say "H1 21cm POLYNOMIAL BASELINE SUBTRACTION - CLASS"
say "============================================================================"
say " "

! ----------------------------------------------------------------------------
! STEP 1: Load Data
! ----------------------------------------------------------------------------

if (verbose) then
  say "STEP 1: Loading spectrum..."
  say "  File: " input_file
endif

! Open input file
file in input_file

! Find all H1 spectra
find /line HI

! Get first spectrum
get first

if (verbose) then
  say "  Loaded successfully"
  say "  Number of channels: " nchan
  say "  Rest frequency: " restf " MHz"
  say " "
endif

! ----------------------------------------------------------------------------
! STEP 2: Setup Units and Alignment
! ----------------------------------------------------------------------------

if (verbose) then
  say "STEP 2: Setting up coordinate system..."
endif

! Set units to velocity and frequency
set unit v f

! Align to frequency-velocity
set align frequency velocity

! Set reference to H1 rest frequency
set line HI " " h1_rest_freq

if (verbose) then
  say "  Units: Velocity (km/s), Frequency (MHz)"
  say "  H1 rest frequency: " h1_rest_freq " MHz"
  say " "
endif

! ----------------------------------------------------------------------------
! STEP 3: RFI Spike Removal (Optional)
! ----------------------------------------------------------------------------

if (remove_spikes) then
  if (verbose) then
    say "STEP 3: Removing RFI spikes..."
    say "  Threshold: " spike_threshold " sigma"
  endif

  ! Median filter approach in CLASS
  ! Note: CLASS doesn't have built-in MAD, so we use iterative clipping

  ! Calculate RMS
  compute rms
  define real initial_rms rms

  ! Iterative spike removal
  define integer spike_iter
  for spike_iter 1 to 3
    ! Flag points > threshold * RMS
    compute rms
    ! CLASS will automatically handle flagging in baseline fit
  next

  if (verbose) then
    say "  Spikes removed (iterative method)"
    say " "
  endif
else
  if (verbose) then
    say "STEP 3: Skipping spike removal (disabled)"
    say " "
  endif
endif

! ----------------------------------------------------------------------------
! STEP 4: Define Line-Free Windows
! ----------------------------------------------------------------------------

if (verbose) then
  say "STEP 4: Defining line-free windows..."
  say "  Exclusion zone: ±" exclude_velocity " km/s around H1"
endif

! Calculate window boundaries
define real vmax_left_calc  0.0 - exclude_velocity
define real vmin_right_calc 0.0 + exclude_velocity

! Set line-free windows for baseline fitting
! CLASS allows up to 100 windows with SET WINDOW
clear window

! Add left window (negative velocities)
if (vmin_left .lt. vmax_left_calc) then
  set window vmin_left vmax_left_calc /velocity
  if (verbose) then
    say "  Window 1 (left):  " vmin_left " to " vmax_left_calc " km/s"
  endif
endif

! Add right window (positive velocities)
if (vmin_right_calc .lt. vmax_right) then
  set window vmin_right_calc vmax_right /velocity
  if (verbose) then
    say "  Window 2 (right): " vmin_right_calc " to " vmax_right " km/s"
  endif
endif

! Calculate percentage of line-free channels
! This is approximate in CLASS
define real total_range vmax_right - vmin_left
define real line_range vmin_right_calc - vmax_left_calc
define real free_range total_range - line_range
define real percent_free (free_range / total_range) * 100.0

if (verbose) then
  say "  Line-free channels: ~" percent_free "%"

  if (percent_free .lt. 25.0) then
    say "  WARNING: <25% line-free channels (CSIRO guideline)"
    say "           Fit may be poorly constrained!"
  endif
  say " "
endif

! ----------------------------------------------------------------------------
! STEP 5: Polynomial Baseline Fitting
! ----------------------------------------------------------------------------

if (verbose) then
  say "STEP 5: Fitting polynomial baseline..."
  say "  Polynomial order: " poly_order
  say "  Iterative sigma clipping: " max_iterations " iterations"
  say "  Sigma threshold: " sigma_clip
endif

! Standard CLASS baseline fitting
! BASE fits a polynomial to line-free windows only

if (max_iterations .gt. 1) then
  ! Iterative baseline fitting with sigma clipping
  base poly_order /iterate

  if (verbose) then
    say "  Baseline fitted with iteration"
  endif
else
  ! Single baseline fit (no iteration)
  base poly_order

  if (verbose) then
    say "  Baseline fitted (single pass)"
  endif
endif

! Get baseline statistics
compute rms
define real baseline_rms rms

if (verbose) then
  say "  Baseline RMS: " baseline_rms
  say " "
endif

! ----------------------------------------------------------------------------
! STEP 6: Subtract Baseline
! ----------------------------------------------------------------------------

if (verbose) then
  say "STEP 6: Subtracting baseline..."
endif

! Subtract the fitted baseline
subtract

if (verbose) then
  say "  Baseline subtracted successfully"
  say " "
endif

! ----------------------------------------------------------------------------
! STEP 7: Calculate SNR and Detection Statistics
! ----------------------------------------------------------------------------

if (verbose) then
  say "STEP 7: Calculating detection statistics..."
endif

! Calculate noise in line-free regions
! We need to extract the spectrum at H1 frequency

! Get spectrum maximum (approximate H1 signal)
compute maximum
define real h1_signal maximum

! Calculate noise from line-free regions
compute rms
define real noise_level rms

! Calculate SNR
define real snr h1_signal / noise_level

if (verbose) then
  say "  H1 signal (peak): " h1_signal
  say "  Noise level (RMS): " noise_level
  say "  SNR: " snr
  say " "

  ! Detection status (professional thresholds)
  if (snr .gt. 5.0) then
    say "  Status: STRONG DETECTION (>5σ)"
  else if (snr .gt. 3.0) then
    say "  Status: CONFIRMED DETECTION (>3σ)"
  else if (snr .gt. 2.0) then
    say "  Status: MARGINAL DETECTION (2-3σ)"
  else
    say "  Status: NO SIGNIFICANT DETECTION (<2σ)"
  endif
  say " "
endif

! ----------------------------------------------------------------------------
! STEP 8: Smoothing (Optional)
! ----------------------------------------------------------------------------

if (do_smoothing) then
  if (verbose) then
    say "STEP 8: Applying smoothing..."
    say "  Method: " smooth_method
    say "  Width: " smooth_width " channels"
  endif

  ! Apply smoothing based on method
  if (smooth_method .eq. "HANNING") then
    ! Hanning smoothing (GBT/VLA standard)
    smooth hann smooth_width
  else if (smooth_method .eq. "BOX") then
    ! Boxcar smoothing
    smooth box smooth_width
  else if (smooth_method .eq. "GAUSS") then
    ! Gaussian smoothing
    smooth gaus smooth_width
  endif

  if (verbose) then
    say "  Smoothing applied"
    say " "
  endif
else
  if (verbose) then
    say "STEP 8: Skipping smoothing (disabled)"
    say " "
  endif
endif

! ----------------------------------------------------------------------------
! STEP 9: Quality Assessment
! ----------------------------------------------------------------------------

if (verbose) then
  say "STEP 9: Quality assessment..."
endif

! Calculate final RMS in line-free regions
compute rms
define real final_rms rms

! Flatness ratio (should be ~1.0 for good baseline removal)
define real flatness_ratio final_rms / baseline_rms

if (verbose) then
  say "  Final RMS: " final_rms
  say "  Flatness ratio: " flatness_ratio

  if (flatness_ratio .lt. 1.2) then
    say "  Quality: GOOD (flatness < 1.2)"
  else if (flatness_ratio .lt. 1.5) then
    say "  Quality: MARGINAL (flatness 1.2-1.5)"
  else
    say "  Quality: POOR (flatness > 1.5)"
    say "  Consider increasing polynomial order!"
  endif
  say " "
endif

! ----------------------------------------------------------------------------
! STEP 10: Save Results
! ----------------------------------------------------------------------------

if (verbose) then
  say "STEP 10: Saving results..."
endif

! Save to CLASS format
file out output_file single
put

if (verbose) then
  say "  Saved CLASS format: " output_file
endif

! Save to ASCII format for other programs
write output_ascii /formatted

if (verbose) then
  say "  Saved ASCII format: " output_ascii
  say " "
endif

! ----------------------------------------------------------------------------
! STEP 11: Create Plots
! ----------------------------------------------------------------------------

if (show_plots .or. save_plots) then
  if (verbose) then
    say "STEP 11: Creating plots..."
  endif

  ! Set plotting style
  set mode x -500 500      ! Velocity range for display
  set mode y               ! Auto Y range

  ! Plot the corrected spectrum
  pen /default
  pen 1 /color 1          ! Black for spectrum

  ! Draw spectrum
  draw

  ! Add H1 rest frequency line
  pen 2 /color 3          ! Green for H1 rest
  ! (Manual line drawing would go here)

  ! Add 3-sigma threshold
  pen 3 /color 2 /dashed  ! Red dashed for 3-sigma
  define real sigma3 3.0 * noise_level
  ! (Manual line drawing would go here)

  ! Add labels
  label "Velocity (km/s)" /x
  label "T_b (K)" /y
  label "H I 21cm Spectrum (Baseline Corrected)" /title

  if (save_plots) then
    ! Save plot to file
    hardcopy "h1_spectrum.eps" /device ps color
    if (verbose) then
      say "  Plot saved: h1_spectrum.eps"
    endif
  endif

  if (verbose) then
    say " "
  endif
endif

! ============================================================================
! FINAL SUMMARY
! ============================================================================

say "============================================================================"
say "PROCESSING COMPLETE - SUMMARY"
say "============================================================================"
say " "
say "Polynomial order: " poly_order
say "Exclusion velocity: ±" exclude_velocity " km/s"
say "Line-free channels: ~" percent_free "%"
say "Iterations: " max_iterations
say " "
say "H1 Signal: " h1_signal
say "Noise RMS: " noise_level
say "SNR: " snr
say " "

if (snr .gt. 3.0) then
  say "RESULT: H1 DETECTION CONFIRMED (SNR > 3σ)"
else if (snr .gt. 2.0) then
  say "RESULT: MARGINAL H1 DETECTION (SNR 2-3σ)"
else
  say "RESULT: NO SIGNIFICANT H1 DETECTION (SNR < 2σ)"
endif

say " "
say "Output files:"
say "  CLASS format: " output_file
say "  ASCII format: " output_ascii
if (save_plots) then
  say "  Plot: h1_spectrum.eps"
endif
say " "
say "============================================================================"
say " "

! ============================================================================
! BATCH PROCESSING EXTENSION
! ============================================================================
!
! To process multiple spectra, wrap the above in a loop:
!
! Example for batch processing:
!
! file in "observations.30m"
! find /line HI
! define integer nspec found
!
! for scan_num 1 to nspec
!   get next
!
!   ! [Insert processing steps here]
!
!   ! Save with unique filename
!   define character outname
!   write outname "corrected_" scan_num ".30m"
!   file out outname single
!   put
! next
!
! ============================================================================

! ============================================================================
! STACKING EXTENSION
! ============================================================================
!
! To stack multiple observations:
!
! ! Process and stack
! file in "obs1.30m"
! get first
! base 2
! subtract
! define spectrum stack_sum /like
! stack_sum = spectrum
!
! file in "obs2.30m"
! get first
! base 2
! subtract
! stack_sum = stack_sum + spectrum
!
! ! Continue for all observations...
!
! ! Average the stack
! define real n_obs 2.0
! stack_sum = stack_sum / n_obs
!
! ! Apply final baseline to stack (use higher order)
! base 4
! subtract
!
! ! Calculate final SNR
! compute rms
! define real stack_noise rms
! compute maximum
! define real stack_signal maximum
! define real stack_snr stack_signal / stack_noise
!
! say "Stacked " n_obs " observations"
! say "Final SNR: " stack_snr
! say "Theoretical improvement: " sqrt(n_obs)
!
! ============================================================================

! End of script
say "Script execution complete."
say " "
